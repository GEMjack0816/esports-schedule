{
  "name": "esports-schedule",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:client-bundle": "node scripts/check-client-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/check-database.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:client-bundle"
  },
  "dependencies": {
    "@vercel/functions": "^3.7.5",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "jose": "^6.2.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
